{
  "name": "tiny-arcade-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "new-game": "node scripts/new-game.mjs",
    "test": "node --test",
    "test:ci": "playwright install --with-deps --only-shell chromium && node scripts/ci-run-tests.mjs",
    "ci": "turbo run build test:ci",
    "audit:autoplay": "node scripts/audit-autoplay.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "turbo": "2.11.10",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@clerk/backend": "3.26.4",
    "@clerk/clerk-js": "6.42.0",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/analytics": "^2.0.1"
  }
}
