# Placeholders only. Copy to an ignored .env.local for isolated local work.
# Vite dev/preview do not execute Vercel Functions; use vercel dev for API work.
# Never use the production database for local tests.
DATABASE_URL=postgresql://USER:PASSWORD@ISOLATED_HOST/DATABASE?sslmode=require

# Public build configuration (S03/S05). VITE_ values enter browser bundles.
VITE_SITE_ORIGIN=https://YOUR_PUBLIC_SITE
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_EXISTING_INSTANCE_PUBLIC_KEY

# Server only (S03). Use one verification key method for the matching instance.
CLERK_SECRET_KEY=sk_test_REPLACE_SERVER_ONLY
# CLERK_JWT_KEY=REPLACE_WITH_MATCHING_PEM_PUBLIC_VERIFICATION_KEY
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Server only (S02). Generate a unique random secret of at least 32 characters.
SCORE_RECEIPT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SCORE_ALLOWED_ORIGINS=http://localhost:3000
SCORE_WRITES_ENABLED=false

# Opt-in live database tests only: a separately confirmed disposable branch.
# SCORE_TEST_DATABASE_URL=postgresql://USER:PASSWORD@ISOLATED_TEST_HOST/DATABASE?sslmode=require
# SCORE_TEST_DATABASE_ISOLATED=1
# SCORE_TEST_PG_MODULE_PATH=REPLACE_WITH_ABSOLUTE_EXTERNAL_PG_MODULE_PATH
